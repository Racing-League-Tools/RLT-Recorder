<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RltUdpClient</AssemblyName>
    <RootNamespace>RltUdpClient.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>rlt_udp.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Bindings are resolved at compile time, which keeps them working under
         trimming and turns a typo into a build error instead of a blank field. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="rlt_udp.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RltUdpClient.Core\RltUdpClient.Core.csproj" />
  </ItemGroup>

</Project>
